rules_version = '2';

// Deployed by control-plane/functions/src/provisioning/deployRules.ts into
// each customer's own, isolated Firebase project — there is exactly one
// workspace per project, so there is no tenantId to check. Anyone who has
// been added as a member (or invited by email, see workspace/config) may
// read/write the shared data.

service cloud.firestore {
  match /databases/{database}/documents {

    function isMember() {
      return request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/workspace/config).data.memberUids;
    }

    function isInvitedByEmail() {
      return request.auth != null && request.auth.token.email != null &&
        request.auth.token.email in
          get(/databases/$(database)/documents/workspace/config).data.pendingInviteEmails;
    }

    match /workspace/config {
      allow read: if request.auth != null;
      // Existing members manage settings/invites; an invited (not yet
      // member) user may only add themselves to memberUids to accept.
      allow update: if isMember() ||
        (isInvitedByEmail() &&
          request.resource.data.memberUids ==
            resource.data.memberUids.concat([request.auth.uid]) &&
          request.resource.data.pendingInviteEmails ==
            resource.data.pendingInviteEmails);
      allow create: if request.auth != null &&
        request.resource.data.memberUids == [request.auth.uid];
    }

    match /wallets/{walletId} {
      allow read, write: if isMember();
    }

    match /categories/{categoryId} {
      allow read, write: if isMember();
    }

    match /transactions/{transactionId} {
      allow read, write: if isMember();
    }

    match /recurringTemplates/{templateId} {
      allow read, write: if isMember();
    }
  }
}
