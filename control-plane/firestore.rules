rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // customers/{uid} is written only by the provisioning Cloud Function
    // (Admin SDK, bypasses rules). The owner may read their own record to
    // track provisioning status and retrieve their firebaseConfig.
    match /customers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
