{
  "name": "flowledger",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev:client": "npm run dev --workspace=client",
    "dev:emulators": "firebase emulators:start",
    "dev": "concurrently \"npm:dev:emulators\" \"npm:dev:client\"",
    "build:client": "npm run build --workspace=client",
    "dev:mobile": "npm run start --workspace=mobile",
    "install:all": "npm install --workspace=client && npm install --workspace=interfaces && npm install --workspace=mobile && npm install --workspace=shared && npm install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlagmanAlex/FlowLedger.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/FlagmanAlex/FlowLedger/issues"
  },
  "homepage": "https://github.com/FlagmanAlex/FlowLedger#readme",
  "type": "module",
  "private": true,
  "workspaces": [
    "client",
    "interfaces",
    "mobile",
    "shared"
  ],
  "devDependencies": {
    "concurrently": "^10.0.5",
    "firebase-tools": "^15.28.1"
  }
}
