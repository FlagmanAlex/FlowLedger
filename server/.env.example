# Локальная разработка: скопировать в .env (в git не попадает).
# На VPS эти же переменные лежат в ~deploy-flowledger/flowledger-server.env (читается pm2-конфигом).
HOST=127.0.0.1
PORT=3100
# Replica set обязателен — серверу нужны транзакции Mongo.
MONGO_URI=mongodb://flowledger:CHANGE_ME@127.0.0.1:27017/flowledger?replicaSet=rs0&authSource=flowledger
MONGO_DB=flowledger
LOG_LEVEL=info
# Подпись access-токенов (HS256), не короче 32 символов: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME
# OAuth client id Google, чьи id_token принимаем (через запятую): Web, Android.
GOOGLE_CLIENT_IDS=493091413384-a49q0ufv83sf3gmmihbg27du1et7nedq.apps.googleusercontent.com,493091413384-fbvosngror8s562emiv8ef562e4p1va1.apps.googleusercontent.com
# Внешний префикс API за nginx (на проде /flowledger) — path refresh-cookie. Локально пусто.
PUBLIC_BASE_PATH=
# Локально по http — false, иначе браузер не сохранит refresh-cookie.
COOKIE_SECURE=false
