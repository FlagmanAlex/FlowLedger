# Локальная разработка: скопировать в .env (в git не попадает).
# На VPS эти же переменные лежат в ~deploy-flowledger/flowledger-server.env (читается pm2-конфигом).
HOST=127.0.0.1
PORT=3100
# Replica set обязателен — серверу нужны транзакции Mongo.
MONGO_URI=mongodb://flowledger:CHANGE_ME@127.0.0.1:27017/flowledger?replicaSet=rs0&authSource=flowledger
MONGO_DB=flowledger
LOG_LEVEL=info
