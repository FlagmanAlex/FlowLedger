rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function tenantId() {
      return request.auth.token.tenantId;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function belongsToTenant(data) {
      return isSignedIn() && data.tenantId == tenantId();
    }

    function createsInOwnTenant() {
      return isSignedIn() && request.resource.data.tenantId == tenantId();
    }

    match /tenants/{tenantDocId} {
      allow read: if isSignedIn() && tenantDocId == tenantId();
      // Tenants are created/updated only by Cloud Functions (Admin SDK bypasses rules).
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /invites/{inviteId} {
      allow read: if belongsToTenant(resource.data);
      allow create: if createsInOwnTenant();
      allow update, delete: if belongsToTenant(resource.data);
    }

    match /wallets/{walletId} {
      allow read: if belongsToTenant(resource.data);
      allow create: if createsInOwnTenant();
      allow update, delete: if belongsToTenant(resource.data);
    }

    match /categories/{categoryId} {
      allow read: if belongsToTenant(resource.data);
      allow create: if createsInOwnTenant();
      allow update, delete: if belongsToTenant(resource.data);
    }

    match /transactions/{transactionId} {
      allow read: if belongsToTenant(resource.data);
      allow create: if createsInOwnTenant();
      allow update, delete: if belongsToTenant(resource.data);
    }

    match /recurringTemplates/{templateId} {
      allow read: if belongsToTenant(resource.data);
      allow create: if createsInOwnTenant();
      allow update, delete: if belongsToTenant(resource.data);
    }
  }
}
