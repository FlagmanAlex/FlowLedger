rules_version = '2';

// Firestore — ТОЛЬКО ЧТЕНИЕ (с cutover на MongoDB 2026-10-13).
//
// Данные живут на своём сервере (server/, MongoDB), Firestore оставлен
// точкой отката до уборки (этап 8 .claude/plans/mongo-migration.md).
// Запись запрещена целиком: иначе вкладка со старым бандлом (загружен до
// cutover) молча сохраняет операции в Firestore, а новая версия их не видит.
// Пусть старый клиент лучше падает с permission-denied.
//
// Чтение оставлено прежним (изоляция по userId + общий доступ через
// users/{ownerId}/members) — для отката. Правила записи до cutover — в
// истории git этого файла. Admin SDK (скрипт переноса данных) правила не
// ограничивают.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Владелец базы ownerId либо участник из users/{ownerId}/members.
    function hasAccess(ownerId) {
      return request.auth != null &&
        (request.auth.uid == ownerId ||
         exists(/databases/$(database)/documents/users/$(ownerId)/members/$(request.auth.uid)));
    }

    match /users/{userId} {
      allow read: if isOwner(userId) ||
        (request.auth != null &&
         exists(/databases/$(database)/documents/users/$(userId)/members/$(request.auth.uid)));

      match /members/{memberId} {
        allow read: if isOwner(userId) || isOwner(memberId);
      }
    }

    match /invites/{inviteId} {
      allow read: if request.auth != null;
    }

    match /wallets/{docId} {
      allow read: if hasAccess(resource.data.userId);
    }

    match /categories/{docId} {
      allow read: if hasAccess(resource.data.userId);
    }

    match /currencies/{docId} {
      allow read: if hasAccess(resource.data.userId);
    }

    match /holders/{docId} {
      allow read: if hasAccess(resource.data.userId);
    }

    match /transactions/{docId} {
      allow read: if hasAccess(resource.data.userId);
    }

    match /recurringTemplates/{docId} {
      allow read: if hasAccess(resource.data.userId);
    }

    match /debts/{docId} {
      allow read: if hasAccess(resource.data.userId);
    }

    match /counterparties/{docId} {
      allow read: if hasAccess(resource.data.userId);
    }
  }
}
